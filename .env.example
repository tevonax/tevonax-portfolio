# Copy to .env.local for local development, and set the same names in your hosting
# provider's environment settings for production. Never commit real values.

# --- Site ---
# Public URL of the deployed site. Drives canonical URLs, Open Graph tags,
# the sitemap and structured data. (On Vercel the production domain is used
# automatically if this is left empty.)
NEXT_PUBLIC_SITE_URL=

# --- Contact form (server-side only; never exposed to the browser) ---
# Without these two the form still renders, and falls back to a prefilled
# email draft so no enquiry is lost.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional. Must be a sender/domain verified in Resend, e.g.
# "Tevonax <no-reply@your-domain.com>". Defaults to Resend's test sender,
# which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=
