# Copy to .env.local for local development, and set the same names in your hosting
# provider's environment settings for production. Never commit real values.

# --- Site ---
# Optional. Production builds already default to https://tevonax.com (see
# `site.url` in src/content/site.ts). Only set this to override it, for
# example on a staging domain.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (server-side only; never exposed to the browser) ---
# Without these two the form still renders, and falls back to a prefilled
# email draft so no enquiry is lost.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional but recommended. Must be on a domain verified in Resend. Resend
# recommends verifying a subdomain, e.g. mail.tevonax.com, then:
# CONTACT_FROM_EMAIL="Tevonax <no-reply@mail.tevonax.com>"
# If empty, Resend's shared test sender is used, which is meant for testing only.
CONTACT_FROM_EMAIL=
